DB_INSTANCE_NAME=ai-factory-db
DB_VERSION=POSTGRES_16
DB_TIER=db-f1-micro
DB_REGION=asia-southeast1
DB_NAME=ai_software_factory
DB_USER=app
DB_PASSWORD_SECRET=database-password
DB_CONNECTION_NAME=PROJECT_ID:asia-southeast1:ai-factory-db
DATABASE_URL=postgresql+asyncpg://app:PASSWORD@/ai_software_factory?host=/cloudsql/PROJECT_ID:asia-southeast1:ai-factory-db

# Production itself now lives on a separate, Terraform-provisioned instance
# (ai-software-factory-production-db) with its own secret
# (ai-software-factory-production-database-url) - the entries above describe the
# older, pre-migration ai-factory-db instance. That instance is reused today only
# for a dedicated, isolated nonprod database so staging/dev deploys can never read
# or write real production data:
NONPROD_DB_INSTANCE_NAME=ai-factory-db
NONPROD_DB_NAME=ai_software_factory_nonprod
NONPROD_DB_USER=nonprod_app
NONPROD_DB_PASSWORD_SECRET=ai-software-factory-nonprod-database-url
DATABASE_URL_NONPROD=postgresql://nonprod_app:PASSWORD@34.87.85.221:5432/ai_software_factory_nonprod
